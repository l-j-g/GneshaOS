#!/usr/bin/env python3
# sway-autotile: alternate the split orientation of newly mapped windows.
#
# Reacts only to newly mapped windows, so a split chosen by hand is never
# revisited: it survives focus changes, and the next new window is oriented
# automatically again.
#
# Stacked and tabbed containers, floating windows and fullscreen windows are
# left alone.
import sys

from i3ipc import Connection, Event

# Below this the aspect ratio is unreliable and the choice is not visible.
MIN_DIMENSION = 50


def is_floating(con):
    """i3ipc reports sway's floating state as auto_off/auto_on/user_off/user_on."""
    state = con.floating
    if isinstance(state, str):
        return state.endswith("_on")
    return bool(state)


def find_with_parent(tree, con_id):
    """Return (con, parent) for con_id in tree, or (None, None).

    Looks the window up by id rather than trusting the event, whose rect is
    stale by the time it is handled.
    """
    def walk(node, parent):
        if node.id == con_id:
            return node, parent
        for child in node.nodes + node.floating_nodes:
            found = walk(child, node)
            if found:
                return found
        return None

    return walk(tree, None) or (None, None)


def skip_reason(con, parent):
    if is_floating(con):
        return "floating"
    if con.fullscreen_mode != 0:
        return "fullscreen"
    if parent.layout in ("stacked", "tabbed"):
        return parent.layout
    return None


def main():
    debug = "-d" in sys.argv[1:]
    conn = Connection()

    def on_new(conn, event):
        try:
            con, parent = find_with_parent(conn.get_tree(), event.container.id)
            if con is None or parent is None:
                return
            reason = skip_reason(con, parent)
            if reason:
                if debug:
                    print("skip (%s): %s" % (reason, con.name), file=sys.stderr)
                return
            rect = con.rect
            if rect.width < MIN_DIMENSION or rect.height < MIN_DIMENSION:
                return
            layout = "splitv" if rect.height > rect.width else "splith"
            if layout == parent.layout:
                if debug:
                    print("already %s: %s" % (layout, con.name), file=sys.stderr)
                return
            conn.command(layout)
            if debug:
                print("%s -> %s: %s" % (parent.layout, layout, con.name), file=sys.stderr)
        except Exception as exc:  # one bad window must not kill the daemon
            print("error: %s" % exc, file=sys.stderr)

    conn.on(Event.WINDOW_NEW, on_new)
    if debug:
        print("listening for new windows", file=sys.stderr)
    conn.main()


if __name__ == "__main__":
    main()
