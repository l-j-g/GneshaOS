#!/bin/sh
# Pick and preview a Base16 theme. Enter applies the runtime preview, writes
# the declarative home/variables.nix selection, and activates Home Manager in
# the background; Escape leaves the configuration unchanged.

set -eu

configDir="${XDG_CONFIG_HOME:-$HOME/.config}/gnesha"
themeCatalog="$configDir/theme-names"
themeData="$configDir/theme-data"
flakePath="${GNESHA_FLAKE_PATH:-/etc/nixos}"
paramsFile="$flakePath/home/variables.nix"
previewScript="${HOME}/.config/sway/scripts/theme-preview"
rofiLauncher="${HOME}/.config/sway/scripts/gnesha-rofi"
homeProfile="${GNESHA_HOME_PROFILE:-__HOME_PROFILE__}"
logDir="$configDir/theme-activation-logs"
previewState=
tmpFile=
previewOpened=0

mkdir -p "$configDir" "$logDir"
chmod 700 "$logDir"
# Serialize picker sessions so cleanup cannot close another picker preview
# and selection writes cannot race. Activation uses BUILD-01's shared lock.
exec 8>"$configDir/theme-picker.lock"
flock -x 8

if [ ! -r "$themeCatalog" ] || [ ! -r "$themeData" ]; then
    notify-send "Theme picker" "Theme catalog is missing; rebuild Home Manager first."
    exit 1
fi

if [ ! -f "$paramsFile" ] || [ ! -w "$paramsFile" ]; then
    notify-send "Theme picker" "Cannot write $paramsFile"
    exit 1
fi

currentTheme=$(sed -nE 's/^[[:space:]]*themeName = "([^"]*)";.*/\1/p' "$paramsFile" | sed -n '1p')
[ -n "$currentTheme" ] || currentTheme=$(sed -n '1p' "$themeCatalog")

cleanup() {
    result=$?
    trap - EXIT HUP INT TERM
    if [ "$previewOpened" -eq 1 ]; then
        "$previewScript" --close "$previewState" >/dev/null 2>&1 || true
    fi
    [ -z "$previewState" ] || rm -f -- "$previewState"
    [ -z "$tmpFile" ] || rm -f -- "$tmpFile"
    exit "$result"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

previewState=$(mktemp "${TMPDIR:-/tmp}/gnesha-theme-preview.XXXXXX")
printf '%s\n' "$currentTheme" > "$previewState"
export GNESHA_THEME_PREVIEW_STATE="$previewState"

if "$previewScript" --open "$previewState" >/dev/null 2>&1; then
    previewOpened=1
else
    notify-send "Theme picker" "Could not open the theme preview; the saved theme was not changed." >/dev/null 2>&1 || true
    exit 1
fi

rows() {
    while IFS="$(printf '\t')" read -r name base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F; do
        [ -n "${name:-}" ] || continue
        swatches=""
        for color in "$base00" "$base01" "$base02" "$base03" "$base04" "$base05" "$base06" "$base07" "$base08" "$base09" "$base0A" "$base0B" "$base0C" "$base0D" "$base0E" "$base0F"; do
            swatches="${swatches}<span foreground='#${color}'>●</span>"
        done
        printf '%s\0display\037%s  %s\n' "$name" "$name" "$swatches"
    done < "$themeData"
}

choice=$(rows | "$rofiLauncher" \
    -dmenu \
    -i \
    -markup-rows \
    -no-custom \
    -p "Theme" \
    -l 14 \
    -select "$currentTheme" \
    -location 1 \
    -xoffset 40 \
    -yoffset 80 \
    -theme-str 'window { width: 48%; }' \
    -on-selection-changed "$previewScript --select {entry}" || true)

[ -n "$choice" ] || exit 0

case "$choice" in
    *[!A-Za-z0-9._-]*)
        notify-send "Theme picker" "Invalid theme name: $choice"
        exit 1
        ;;
esac

if ! grep -Eq '^[[:space:]]*themeName = "[^"]*";' "$paramsFile"; then
    notify-send "Theme picker" "themeName is missing from $paramsFile"
    exit 1
fi

if ! "$previewScript" --apply "$choice"; then
    notify-send "Theme picker" "Preview failed; the saved theme was not changed. The live preview may be partial." >/dev/null 2>&1 || true
    exit 1
fi

# Serialize this source edit with update-apply's final freshness check. The
# activation process will acquire the same lock again when it starts.
activationStateDir="$HOME/.local/state/gnesha-activation"
mkdir -p "$activationStateDir"
chmod 700 "$activationStateDir"
exec 9>"$activationStateDir/activation.lock"
chmod 600 "$activationStateDir/activation.lock"
flock -x 9

tmpFile=$(mktemp "$(dirname "$paramsFile")/.variables.nix.XXXXXX")
paramsMode=$(stat -c '%a' "$paramsFile")
sed -E "s|^([[:space:]]*themeName = ).*;|\1\"$choice\";|" "$paramsFile" > "$tmpFile"
chmod "$paramsMode" "$tmpFile"

if ! cmp -s "$paramsFile" "$tmpFile"; then
    mv -f -- "$tmpFile" "$paramsFile"
    tmpFile=
else
    rm -f -- "$tmpFile"
    tmpFile=
fi
flock -u 9
exec 9>&-

activationLog="$logDir/home-activation-$(date -u +%Y%m%dT%H%M%SZ)-$$.log"
if command -v nh >/dev/null 2>&1; then
    # Keep the selector responsive while the standalone Home Manager
    # activation updates the declarative generation in the background.
    # shellcheck disable=SC2016
    nohup sh -c '
        if gnesha-activation-lock nh home switch "$1" -c "$2" --no-nom >"$3" 2>&1; then
            notify-send "Theme activated" "$2" >/dev/null 2>&1 || true
        else
            notify-send "Theme activation failed" "Saved theme remains configured; live preview may differ. See $3" >/dev/null 2>&1 || true
        fi
    ' theme-home-activation "$flakePath" "$homeProfile" "$activationLog" >/dev/null 2>&1 &
    notify-send "Theme saved" "$choice — Home Manager activation started. Log: $activationLog" >/dev/null 2>&1 || true
else
    notify-send "Theme saved" "$choice — runtime preview active; Home Manager was not available, so run home-rebuild" >/dev/null 2>&1 || true
fi
