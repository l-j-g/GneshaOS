#!/usr/bin/env bash
# Show the AirVPN WireGuard status and toggle its NetworkManager connection.
# Used by the Waybar custom/vpn module.

set -euo pipefail

connection="AirVPN"

is_active() {
  nmcli --terse --fields NAME connection show --active | grep --fixed-strings \
    --line-regexp --quiet "$connection"
}

status() {
  if is_active; then
    printf '{"text":"󰒃","class":"connected","tooltip":"AirVPN connected"}\n'
  else
    printf '{"text":"󰒄","class":"disconnected","tooltip":"AirVPN disconnected"}\n'
  fi
}

toggle() {
  if is_active; then
    nmcli connection down id "$connection"
  else
    nmcli connection up id "$connection"
  fi
  status
}

command="${1:-status}"
case "$command" in
  status)
    status
    ;;
  toggle)
    toggle
    ;;
  *)
    printf 'usage: %s {status|toggle}\n' "$0" >&2
    exit 2
    ;;
esac
