# Report how many package updates the next rebuild would apply. The count is
# cached by the gnesha-lock-refresh job because computing it takes seconds.
#
# Usage: updates-pending [status|review]
set -eu

# shellcheck source=/dev/null
. "__PENDING_COUNT_LIB__"

case "${1:-status}" in
  review)
    # Rebuild activates whatever flake.lock already resolves to, so reviewing
    # means showing the version diff against the downloaded closures. Run in a
    # terminal because nvd output is long.
    exec ${TERMINAL_COMMAND:-foot} -e updates-pending-review
    ;;
  status) ;;
  *)
    echo "Usage: updates-pending [status|review]" >&2
    exit 2
    ;;
esac

if ! counts=$(pending_count); then
  # No refresh has completed yet. Distinguish "never ran" from "running now".
  if systemctl is-active --quiet gnesha-lock-refresh.service; then
    printf '{"text":" 󰥔 ","tooltip":{"text":"Refreshing packages..."},"class":"working"}\n'
  else
    printf '{"text":" 󰥔 ","tooltip":{"text":"No pending-update data yet.\\nRun: sudo systemctl start gnesha-lock-refresh"},"class":"unknown"}\n'
  fi
  exit 0
fi

# shellcheck disable=SC2086 # deliberate split: counts is two whitespace-separated numbers
set -- $counts
system_count=${1:-0}
home_count=${2:-0}
total=$((system_count + home_count))

built_at=$(pending_built_at || echo unknown)
age=$(pending_age_days || echo 0)

icon=" 󰥚 "
if [ "$total" -eq 0 ]; then
  class=current
  icon=" 󰥔 "
elif [ "$age" -ge 2 ]; then
  # Nothing refreshed recently, so the number may understate what is available.
  class=stale
  icon=" 󰥖 "
else
  class=pending
fi

tooltip="Ready to apply on next rebuild:
  ${system_count} system packages
  ${home_count} home packages

Refreshed ${built_at}"

printf '{"text":"%s%s ","tooltip":{"text":"%s"},"class":"%s"}\n' \
  "$icon" "$total" "$tooltip" "$class"