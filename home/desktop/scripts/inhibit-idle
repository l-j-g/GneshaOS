#!/usr/bin/env python3
# Toggle sway idle inhibition on the focused window (sway's inhibit_idle).
# Usage: inhibit-idle [toggle|on|off]
import json
import subprocess
import sys


def find_focused_leaf(node):
    if node.get("focused"):
        n = node
        while True:
            kids = n.get("nodes", []) + n.get("floating_nodes", [])
            focused = [k for k in kids if k.get("focused")]
            if not focused:
                return n
            n = focused[0]
    for k in node.get("nodes", []) + node.get("floating_nodes", []):
        r = find_focused_leaf(k)
        if r:
            return r
    return None


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    tree = json.loads(subprocess.run(
        ["swaymsg", "-t", "get_tree"], capture_output=True, text=True, check=True).stdout)
    node = find_focused_leaf(tree)
    if not node or "id" not in node:
        sys.exit(1)
    current = node.get("inhibit_idle", "none")
    if mode == "toggle":
        new = "open" if current == "none" else "none"
    else:
        new = "open" if mode in ("on", "open") else "none"
    subprocess.run(
        ["swaymsg", "[con_id=%d] inhibit_idle %s" % (node["id"], new)],
        check=True)


if __name__ == "__main__":
    main()
